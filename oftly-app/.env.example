# Copy to .env. NO secrets or API keys are required to run OFTLY. Nothing here is committed with real values.
OFTLY_PORT=8000
# OFTLY_DATA=/path/for/databases-and-photos        # default ./data  (accounts.db + users/<id>/ per account)

# --- private beta / hosting ---
# OFTLY_INVITE_CODES=code-one,code-two             # if set, registration requires one of these codes
# OFTLY_PUBLIC_URL=https://your-domain.example      # used in password-reset links
# OFTLY_ALLOWED_HOSTS=your-domain.example           # extra Host names accepted (comma separated); localhost is always allowed
# OFTLY_COOKIE_SECURE=1                             # force Secure cookies (set this whenever the site is served over HTTPS)
# OFTLY_MAX_PHOTOS=1000                             # per-user photo limit

# --- password-reset email (choose one; with none, use `python -m app.admin reset-link EMAIL`) ---
# OFTLY_MAIL=smtp
# OFTLY_SMTP_HOST=smtp.example.com
# OFTLY_SMTP_PORT=587
# OFTLY_SMTP_USER=...
# OFTLY_SMTP_PASS=...                               # keep in .env only, never commit
# OFTLY_SMTP_FROM=OFTLY <no-reply@your-domain.example>

# --- development / testing only (leave unset in any shared environment) ---
# OFTLY_DEBUG=1                                     # enables /docs and /openapi.json
# OFTLY_ENABLE_DEMO=1                               # enables sample-item endpoints (automated tests use this)
# OFTLY_INTELLIGENCE_URL=http://127.0.0.1:9911      # optional local intelligence service (loopback only)
